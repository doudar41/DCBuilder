  m_Script: {fileID: 11500000, guid: 8fc4bf8bed5e41a4fa66bd7300eb3474, type: 3}
  m_Name: FirstDukeTalk
  m_EditorClassIdentifier: 
  uniqueName: 3
  dialogue_phrases:
  - portraits: {fileID: 21300000, guid: 8e78f8b2b22c138418b82972c188c268, type: 3}
    dialogueTexts: "So you are the next batch of fools then? The \u201CDeath Crusaders\u201D?
      Yes?!  That is a damned and ambitious promotion!!! Do you even know what that
      entails? Do you know the risks?"
  - portraits: {fileID: 21300000, guid: 8e78f8b2b22c138418b82972c188c268, type: 3}
    dialogueTexts: "Fine, I don\u2019t care\u2026 Here\u2019s your very own trial
      then: Head to the caves past the woods to the west. Once there, find the secret
      path deeper within and the reason why all sorts of beasts have started pouring
      out during the daytime. "
  - portraits: {fileID: 21300000, guid: 8e78f8b2b22c138418b82972c188c268, type: 3}
    dialogueTexts: "A thousand Gold to set you on your way. Won\u2019t get you much
      but at least I can send the next band of fools over to collect whatever you
      leave on your corpse when you eventually die. Go on, off with you!"
  journalEnter: "The Duke sounded more depressed than insane, but the trial seems
    safe enough.There\u2019s now a clear goal: Find the caves to the west and figure
    out why the monsters are leaving the den during the day. It would be wise to
    stock up on rations and some weapons before heading out."
  priorityIndex: 2
